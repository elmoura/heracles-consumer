# MongoDB
MONGO_URI=mongodb://localhost:27017/heracles

# RabbitMQ (alinhar com hermes-api)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_WHATSAPP_INBOUND_EXCHANGE=whatsapp.inbound.fanout
# Uma fila: persist inbound + resposta IA no mesmo handler
RABBITMQ_QUEUE_WHATSAPP_INBOUND_PERSIST=q.whatsapp.inbound.persist
RABBITMQ_REALTIME_EXCHANGE=realtime.events.topic

# Contexto da conversa (mensagens carregadas para o prompt)
HERACLES_CONTEXT_MAX_MESSAGES=20
# Opcional: texto do bloco NEGÓCIO se a org não tiver businessContext em Mongo
HERACLES_BUSINESS_CONTEXT_STUB=

# Mistral AI (La Plateforme — https://console.mistral.ai/)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Mesmo modelo que no Hermes no import CSV (mistral-embed → 1024 dim)
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Qdrant (retrieve de catálogo por organização + agente; coleção fixa catalog_items)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=1024
QDRANT_TOP_K=5
# Opcional: filtrar hits com score abaixo deste limiar (similaridade coseno)
QDRANT_SCORE_THRESHOLD=
